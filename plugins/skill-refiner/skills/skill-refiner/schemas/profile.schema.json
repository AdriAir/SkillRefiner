{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AdriAir/SkillRefiner/schemas/profile.schema.json",
  "type": "object",
  "properties": {
    "language": {
      "enum": [
        "es",
        "en"
      ]
    },
    "tone": {
      "enum": [
        "professional",
        "friendly",
        "direct"
      ]
    },
    "detail": {
      "enum": [
        "concise",
        "medium",
        "detailed"
      ]
    },
    "conventions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 128
    }
  },
  "required": [],
  "additionalProperties": false
}
