{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AdriAir/SkillRefiner/schemas/proposal.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "base_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "proposal_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "base_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "new_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "path",
          "base_hash",
          "new_hash",
          "content"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 256
    },
    "diff": {
      "type": "string"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "risk": {
      "type": "string",
      "maxLength": 8192
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 4096
      },
      "maxItems": 64
    }
  },
  "required": [
    "schema_version",
    "id",
    "base_digest",
    "proposal_digest",
    "changes",
    "diff",
    "purpose",
    "risk",
    "verification"
  ],
  "additionalProperties": false
}
